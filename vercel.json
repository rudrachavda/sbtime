{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/frontend",
      "framework": "vite",
      "routes": [
        {
          "src": "/((?!.*\\.).*)",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/index.html" }
          ]
        }
      ]
    },
    "backend": {
      "root": "apps/backend",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
